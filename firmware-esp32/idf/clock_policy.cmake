# Runs after IDF has loaded the effective SDKCONFIG. Defaults never overwrite a
# cached value. Derive intent from the requested profile, not the cached config.
set(mm_expected_policy SIGNED_BACKEND_TIME)
foreach(mm_defaults IN LISTS SDKCONFIG_DEFAULTS)
    get_filename_component(mm_profile "${mm_defaults}" NAME)
    if(mm_profile STREQUAL "sdkconfig.dev" OR mm_profile STREQUAL "sdkconfig.field-alpha")
        set(mm_expected_policy FIELD_ALPHA_PHONE_CLOCK)
    elseif(mm_profile STREQUAL "sdkconfig.signed-time")
        set(mm_expected_policy SIGNED_BACKEND_TIME)
    endif()
endforeach()
if(DEFINED MM_SECURITY_CLOCK_POLICY)
    set(mm_expected_policy "${MM_SECURITY_CLOCK_POLICY}")
endif()
if(NOT mm_expected_policy MATCHES "^(FIELD_ALPHA_PHONE_CLOCK|SIGNED_BACKEND_TIME)$")
    message(FATAL_ERROR "Invalid MM_SECURITY_CLOCK_POLICY=${mm_expected_policy}")
endif()
set(mm_actual_policy SIGNED_BACKEND_TIME)
if(CONFIG_MM_FIELD_ALPHA_PHONE_CLOCK)
    set(mm_actual_policy FIELD_ALPHA_PHONE_CLOCK)
endif()
if(NOT mm_actual_policy STREQUAL mm_expected_policy)
    message(FATAL_ERROR "Security clock policy mismatch: requested=${mm_expected_policy}, SDKCONFIG=${mm_actual_policy} (${SDKCONFIG}). Existing SDKCONFIG overrides defaults. Preserve issuer pins and NVS: edit ONLY CONFIG_MM_FIELD_ALPHA_PHONE_CLOCK=y for alpha, or '# CONFIG_MM_FIELD_ALPHA_PHONE_CLOCK is not set' for signed time in this file; then rerun the same build. Do not delete SDKCONFIG. See docs/issue195-default-clock-policy.md.")
endif()
option(MM_ALLOW_FIELD_ALPHA "Deliberately accept insecure field-alpha firmware outside dev (never hardened production)" OFF)
if(CONFIG_MM_FIELD_ALPHA_PHONE_CLOCK AND NOT MM_DEVELOPMENT_BUILD AND NOT MM_ALLOW_FIELD_ALPHA)
    message(FATAL_ERROR "FIELD_ALPHA_PHONE_CLOCK forbidden in release without explicit -DMM_ALLOW_FIELD_ALPHA=ON risk acceptance; use SIGNED_BACKEND_TIME for hardened production")
endif()
message(STATUS "security_clock_policy=${mm_actual_policy}; development=${MM_DEVELOPMENT_BUILD}; alpha_release_acceptance=${MM_ALLOW_FIELD_ALPHA}")
