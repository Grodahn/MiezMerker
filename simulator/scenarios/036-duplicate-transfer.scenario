# Duplicate transfer idempotency (issue #7).
# Same records transferred multiple times create no duplicate logical local
# records on the collector; final node state stays correct.
name: ble-duplicate-transfer
version: 1
description: Repeated batch delivery is idempotent on both ends.

boot
import_fixture_node sim-main
claim_mode_enter
claim_as admin
assert last_claim ok
rtc SYNCED 1790899200000
read CHIP-X
read CHIP-Y
assert observations 2
phone_connect
provide_credential admin
assert last_auth ok
ble_batch 1 16
assert batch_count 2
collector_persist
assert collector_persisted 2
# Same batch again: no duplicate logical records.
ble_batch 1 16
assert batch_count 2
collector_persist
assert collector_persisted 2
assert collector_watermark 2
# Third delivery of a sub-range is still idempotent.
ble_batch 2 16
assert batch_count 1
collector_persist
assert collector_persisted 2
send_ack
assert last_ack ok
assert ack_watermark 2
# Re-ACK of the same watermark stays idempotent (lost-ACK path).
send_ack 2
assert last_ack ok
assert ack_watermark 2
ble_compact
assert observations 0
sync_complete
phone_disconnect
