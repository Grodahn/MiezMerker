# Protocol compatibility (issue #7).
# Supported version succeeds; unknown/incompatible version and malformed
# frames are rejected by the real GattRouter without touching protected state.
name: ble-protocol-compat
version: 1
description: Version negotiation and malformed-frame handling via real router.

boot
import_fixture_node sim-main
claim_mode_enter
claim_as admin
assert last_claim ok
phone_connect
# Supported version negotiates cleanly.
hello 1
assert last_hello_error 0
# Unknown/incompatible protocol version is rejected, no protected data leaks.
ble_version 2
assert last_frame_error 1
ble_version 9
assert last_frame_error 1
# Malformed frames are rejected.
ble_malformed
assert last_frame_error 4
# Invalid batch cursors are rejected without state change.
provide_credential member
assert last_auth ok
ble_batch 0 8
assert last_batch_error 4
ble_batch 1 0
assert last_batch_error 4
# Valid path still works after the rejections.
ble_batch 1 16
assert batch_count 0
phone_disconnect
