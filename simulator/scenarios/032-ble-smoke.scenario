# BLE smoke: fixture import, claim, connect, auth, batch, persist, ack
name: ble-smoke
version: 1
description: Minimal BLE/security path with real SyncServer/GattRouter/OfflineAuthSession.

boot
import_fixture_node sim-main
assert node_id 3a3a3a3a-3a3a-4a3a-8a3a-3a3a3a3a3a3a
assert claim_state UNCLAIMED
assert owner_org empty
claim_mode_enter
assert claim_mode on
claim_as admin
assert last_claim ok
assert claim_state CLAIMED
rtc SYNCED 1790899200000
read CHIP-001
advance_ms 3000
read CHIP-002
advance_ms 3000
read CHIP-003
assert observations 3
phone_connect
assert ble_connected
hello
assert last_hello_error 0
owner
assert last_owner_org 0a0a0a0a-0a0a-4a0a-8a0a-0a0a0a0a0a0a
provide_credential member
assert last_auth ok
assert ble_authorized
sync_start
ble_status
assert sync_pending 3
ble_batch 1 16
assert batch_count 3
assert batch_cursor 4
collector_persist
assert collector_persisted 3
assert collector_watermark 3
send_ack
assert last_ack ok
assert ack_watermark 3
ble_compact
assert last_compact ok
assert observations 0
sync_complete
phone_disconnect
assert ble_disconnected
