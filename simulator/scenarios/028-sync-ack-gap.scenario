# Sync ACK watermark semantics
name: sync-ack-watermark
version: 1
description: Sync ACK enforces contiguous high-watermark; gaps block advance.

boot
sync_claim
rtc SYNCED 1700000000000
read CHIP-001
read CHIP-002
read CHIP-003
assert observations 3

# ACK 2 succeeds
sync_ack 2
assert last_ack true
assert ack_watermark 2

# ACK 3 succeeds
sync_ack 3
assert last_ack true
assert ack_watermark 3

# Gap: record 4 missing, try ACK 5 -> fail
fail_append 1
read CHIP-005
assert last_result IO_ERROR
# Sequence 4 was reserved but never appended.
sync_ack 5
assert last_ack false
assert ack_watermark 3

# The next read receives sequence 5; the missing 4 still blocks the ACK.
read CHIP-004
sync_ack 5
assert last_ack false
assert ack_watermark 3
sync_compact
assert observations 1

# Re-ACK same value is idempotent
sync_ack 3
assert last_ack true
assert ack_watermark 3
