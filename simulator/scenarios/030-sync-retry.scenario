# Sync retry after disconnect and power loss
name: sync-retry-after-disconnect
version: 1
description: Sync resumes at ack+1 after link loss; lost ACK handled idempotently.

boot
rtc SYNCED 1700000000000
read CHIP-001
read CHIP-002
read CHIP-003
read CHIP-004
assert observations 4

sync_ack 2
assert ack_watermark 2

reboot
assert ack_watermark 2
assert observations 4

sync_batch 3 16
assert last_batch_request_from 3

sync_ack 4
assert last_ack true
assert ack_watermark 4

fail_watermark_next
sync_ack 4
assert last_ack false
assert ack_watermark 4

sync_ack 4
assert last_ack true
assert ack_watermark 4

sync_compact
assert observations 0